{% extends 'partials/base.html.twig' %}

{% block content %}
  {% set h = page.header %}
  <section aria-labelledby="hero-heading">
    <div class="max-w-2xl space-y-6 animate-fade-in">
      <h1 id="hero-heading" class="text-4xl md:text-5xl font-bold tracking-tight text-text-primary">
        Hi, I'm <span class="text-brand">{{ h.hero_name }}</span>.
      </h1>
      <p class="text-lg leading-relaxed transition-colors text-text-secondary">{{ h.hero_tagline }}</p>
    </div>
  </section>

  {% include 'partials/social-links.html.twig' %}

  {% if h.stack %}
  <section aria-labelledby="skills-heading" class="w-full">
    <h2 id="skills-heading" class="text-xs uppercase tracking-widest font-bold mb-6 font-mono text-brand">Stack</h2>
    <ul class="flex flex-wrap gap-3 list-none p-0 m-0" role="list" aria-label="Technology stack">
      {% for tech in h.stack %}
        <li class="skill-tag px-4 py-2 rounded-md text-sm bg-brand/10 text-brand border border-brand/30 font-mono transition-transform duration-500 hover:-translate-y-0.5 hover:bg-brand/30 cursor-default">{{ tech }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section aria-labelledby="projects-heading" class="w-full">
    <h2 id="projects-heading" class="text-xs uppercase tracking-widest font-bold mb-6 font-mono text-brand">Output</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
      {% for project in h.projects %}
      <a href="{{ project.url }}" target="_blank" rel="noopener noreferrer" class="block group h-full">
        <div class="tech-card rounded-lg p-6 h-full flex flex-col bg-surface border border-brand/20 transition-all duration-300 hover:-translate-y-1 hover:border-brand hover:shadow-lg hover:shadow-brand/20">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 mb-4 text-brand" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5zm6-10.125a1.875 1.875 0 1 1-3.75 0 1.875 1.875 0 0 1 3.75 0zm1.294 6.336a6.721 6.721 0 0 1-3.17.789 6.721 6.721 0 0 1-3.168-.789 3.376 3.376 0 0 1 6.338 0z"></path>
          </svg>
          <h3 class="text-lg font-bold mb-2 group-hover:underline text-text-primary">{{ project.title }}</h3>
          <p class="text-sm mb-4 text-text-secondary flex-grow">{{ project.description }}</p>
          {% if project.tags %}
          <ul class="flex gap-2 font-mono text-xs flex-wrap text-brand list-none p-0 m-0 mb-4" role="list">
            {% for tag in project.tags %}<li>{{ tag }}</li>{% endfor %}
          </ul>
          {% endif %}
          <div class="font-mono text-xs text-brand mt-auto">View Project ↗</div>
        </div>
      </a>
      {% endfor %}
    </div>

    {% if h.build_log or h.build_status %}
    <div class="text-sm text-text-secondary font-mono border-l-2 border-brand/50 pl-4 py-3 bg-surface-alt/50 rounded-r">
      {% for line in h.build_log %}{{ line }}<br />{% endfor %}
      {% if h.build_status %}<span class="text-brand inline-block mt-2 animate-pulse">{{ h.build_status }}</span>{% endif %}
    </div>
    {% endif %}
  </section>

  {% set blog = page.find(site.blog.route|default('/blog')) %}
  {% if blog %}
  {% set posts = blog.collection({'items': '@self.children', 'order': {'by': 'date', 'dir': 'desc'}, 'url_taxonomy_filters': false}).published().slice(0, 3) %}
  <section aria-labelledby="blog-heading" class="w-full">
    <div class="flex items-center justify-between mb-6">
      <h2 id="blog-heading" class="text-xs uppercase tracking-widest font-bold font-mono text-brand">{{ blog.title }}</h2>
      <a href="{{ blog.url }}" class="text-xs font-mono text-text-secondary hover:text-brand transition-colors">View All ↗</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for post in posts %}
        {% include 'partials/post-card.html.twig' with { post: post } %}
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="w-full" aria-labelledby="game-heading">
    <h2 id="game-heading" class="sr-only">Interactive Jump Game</h2>
    <div id="game-container" role="application" aria-label="Jump game - Press space or tap to jump over obstacles" class="relative mx-auto w-full h-[140px] overflow-hidden border-b-2 border-brand transition-colors duration-500">
      <canvas id="gameCanvas" aria-label="Game canvas" class="block w-full h-full"></canvas>
      <div id="game-overlay" class="absolute inset-0 bg-surface/90 flex flex-col items-center justify-center z-10 transition-colors duration-500">
        <p class="text-sm uppercase tracking-widest font-bold font-mono mb-2 text-brand">System Idle</p>
        <button type="button" id="start-btn" class="px-6 py-2 rounded shadow-lg font-mono text-sm font-bold transition-transform hover:scale-105 bg-brand text-surface" aria-label="Start the jump game">INITIATE</button>
        <p class="text-xs mt-3 font-mono text-text-secondary">Tap / Space</p>
      </div>
    </div>
  </section>
  <div id="game-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  {% do assets.addJs('theme://js/game.js', {loading: 'defer'}) %}
{% endblock %}
