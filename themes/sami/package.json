{
  "name": "grav-theme-sami",
  "private": true,
  "description": "Builds css/site.css for the sami.codes Grav theme",
  "scripts": {
    "build": "tailwindcss -i css/src/site.css -o css/site.css --minify",
    "watch": "tailwindcss -i css/src/site.css -o css/site.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "tailwindcss": "^3.4.19"
  }
}
